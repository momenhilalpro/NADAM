rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.email == 'momenhilal6942@gmail.com'
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          )
        );
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /meta/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.deliveryStage == 'pending'
        && request.resource.data.productId is int
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0;
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'completed'
          && !resource.data.keys().hasAny(['returnRequest'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnRequest'])
          && request.resource.data.returnRequest is map
          && request.resource.data.returnRequest.status == 'requested'
          && request.resource.data.returnRequest.items is list
        );
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer';
      allow update: if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);
      allow update, delete: if isAdmin();
      allow create: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
