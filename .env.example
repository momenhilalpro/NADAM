VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Server-only Gemini key for chatbot, comparison analysis, and AI recommendations; never prefix it with VITE_.
GEMINI_API_KEY=
# Required for server-side Firestore access unless using Google Application Default Credentials.
# Provide the service-account JSON as a single-line value; never commit the populated .env file.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional ADC configuration alternative:
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
